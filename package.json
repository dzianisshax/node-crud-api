{
  "name": "crud-api",
  "version": "1.0.0",
  "description": "Simple CRUD API for a Product Catalog",
  "engines": {
    "node": ">=24.10.0",
    "npm": ">=10.9.2"
  },
  "type": "module",
  "scripts": {
    "start:dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --clean",
    "start": "node dist/index.js",
    "start:prod": "npm run build && npm run start",
    "start:multi": "tsup src/cluster.ts --format esm --clean && node dist/cluster.js",
    "test": "vitest --reporter=verbose"
  },
  "dependencies": {
    "fastify": "^5.8.2"
  },
  "keywords": [
    "nodejs"
  ],
  "author": "dzianisshax",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
